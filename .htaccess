<IfModule mod_rewrite.c>
RewriteEngine On

# When a folder is requested without "/", add the slash (needed for /team → /team/)
DirectorySlash On

# Hide directory listings
Options -Indexes

# --------------------------------------------------
# Real files — leave alone
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# --------------------------------------------------
# Redirect /index.php → folder root
# --------------------------------------------------
RewriteCond %{THE_REQUEST} /index\.php[\s?] [NC]
RewriteRule ^index\.php$ ./ [R=301,L]

# --------------------------------------------------
# Redirect visible *.php → extensionless (skip admin)
# --------------------------------------------------
RewriteCond %{THE_REQUEST} \s[^\s]*?\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !/admin/ [NC]
RewriteRule ^(.+)\.php$ $1 [R=301,L]

# --------------------------------------------------
# Extensionless → .php when matching file exists
# (does not apply to /team/ — that uses team/index.php)
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
</IfModule>

DirectoryIndex index.php index.html
